# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# PyInstaller build output
build/
dist/
release_assets/
*.manifest

# Release packaging script — kept local on purpose, removed from the repo in
# 0df0029. Recover it with: git show 27b52a3:make_release.py > make_release.py
make_release.py

# Runtime / user data — created next to the exe at runtime, never commit.
# faceit_key.txt is a personal API credential: it must never reach the repo.
skins.db
*.db
faceit_key.txt
plugin_versions.json
demo_library.json
faceit_avatars.json
demos_cache/
cs2Server/
overlay_state.json

# Anything that looks like a credential, whatever it ends up being called.
# Cheap insurance: the rules above only cover the names we ship today.
*.key
*.pem
*.pfx
.env
.env.*
*secret*
*_token*
credentials*

# Logs & local backups
*.log
*.bak
*_backup*/
_databackup_*/
_audit_backup_*/
design_backup_*/

# C# plugin build output (plugin/ sources are kept, artifacts are not)
plugin/**/bin/
plugin/**/obj/

# OS / editor cruft
Thumbs.db
.DS_Store
.idea/
.vscode/

# Working notes: TODO lists, reminders, command crib sheets, half-finished
# drafts. Useful next to the code, worthless in the history — they read as
# noise in a diff, go stale within a week and leak whatever was on your mind.
NOTES.md
TODO.md
notes/
scratch/
drafts/
*_notes.md
*.notes.md
*.draft.md
*.scratch.*
cheatsheet*
шпаргалка*
заметки*

# The release walkthrough — a crib sheet for whoever runs the build, removed
# from the repo in c95cd91. Recover it with:
#   git show 4e27e37:RELEASING.md > RELEASING.md
RELEASING.md

# Icon builder: renders icon.svg into icon.ico. Belongs to the machine that
# builds, not to the product, same as make_release.py above. Recover it with:
#   git show e5e6f05:svg2ico.ps1 > svg2ico.ps1
svg2ico.ps1

# Agent/editor local state. The whole folder: agent worktrees are checked out
# into .claude/worktrees/ and that is a second copy of the repo inside the repo.
.claude/
