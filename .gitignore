# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# PyInstaller build output
build/
dist/
release_assets/
*.manifest

# Release packaging script — kept local on purpose, removed from the repo in
# 0df0029. Recover it with: git show 27b52a3:make_release.py > make_release.py
make_release.py

# Runtime / user data — created next to the exe at runtime, never commit.
# faceit_key.txt is a personal API credential: it must never reach the repo.
skins.db
*.db
faceit_key.txt
plugin_versions.json
demo_library.json
faceit_avatars.json
demos_cache/
cs2Server/
overlay_state.json

# Anything that looks like a credential, whatever it ends up being called.
# Cheap insurance: the rules above only cover the names we ship today.
*.key
*.pem
*.pfx
.env
.env.*
*secret*
*_token*
credentials*

# Logs & local backups
*.log
*.bak
*_backup*/
_databackup_*/
_audit_backup_*/
design_backup_*/

# C# plugin build output (plugin/ sources are kept, artifacts are not)
plugin/**/bin/
plugin/**/obj/

# OS / editor cruft
Thumbs.db
.DS_Store
.idea/
.vscode/
